{
  "name": "free-pdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Editor PDF gratuito y privado que funciona en el navegador.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
